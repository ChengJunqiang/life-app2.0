{
  "name": "life-app2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:ios",
    "dev:ios": "node scripts/run-with-modern-node.cjs scripts/run-native-dev.cjs ios",
    "dev:android": "node scripts/run-with-modern-node.cjs scripts/run-native-dev.cjs android",
    "web": "node scripts/run-with-modern-node.cjs ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "preview": "node scripts/run-with-modern-node.cjs ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "build": "node scripts/run-with-modern-node.cjs ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node scripts/run-with-modern-node.cjs ./node_modules/vite/bin/vite.js build",
    "typecheck": "node scripts/run-with-modern-node.cjs ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "node scripts/run-with-modern-node.cjs --test tests/*.test.mjs",
    "cap:prepare": "node scripts/run-with-modern-node.cjs scripts/prepare-native.cjs",
    "cap:sync": "npm run build && node scripts/run-with-modern-node.cjs ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:ios": "node scripts/run-with-modern-node.cjs ./node_modules/@capacitor/cli/bin/capacitor open ios",
    "cap:android": "node scripts/run-with-modern-node.cjs ./node_modules/@capacitor/cli/bin/capacitor open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2"
  }
}
